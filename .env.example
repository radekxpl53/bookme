APP_NAME=BookMe
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pl_PL

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Baza danych: nazwa hosta "db" = nazwa usługi z docker-compose ---
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=bookme
DB_USERNAME=bookme
DB_PASSWORD=secret

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Mail (log driver - maile lądują w storage/logs, bez Mailpita) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@bookme.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- Klucz do Nominatim/OpenStreetMap nie jest wymagany ---
